# Copie este arquivo para .env.local para testar localmente com "vercel dev".
# Em produção, estas variáveis NÃO vão neste arquivo: configure em
# Vercel > Project Settings > Environment Variables.
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Banco de usuários (login/admin), preenchido automaticamente ao criar/vincular um banco
# de Redis pelo Vercel Marketplace (Storage > Create Database > Redis). Vem com um destes
# dois pares de nome, dependendo da integração usada — o código aceita qualquer um deles:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# String aleatória longa, só para assinar o token de sessão de login. Gere uma com, por
# exemplo, "openssl rand -hex 32" — nunca reaproveite um valor de exemplo em produção.
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Restrição de acesso por IP (ver middleware.js), opcional: lista separada por vírgula.
# ALLOWED_IPS=186.193.236.194,179.191.112.34
